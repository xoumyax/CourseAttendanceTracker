# Copy to .env and edit. .env is git-ignored; never commit it.

# --- Required ---------------------------------------------------------------
# At least 32 characters. Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start if this is unset or still the placeholder.
SECRET_KEY=change-me

# --- Course ------------------------------------------------------------------
# Shown in page titles and headings.
COURSE_NAME=My Course
# IANA timezone name. Check-in windows, "today" and displayed times use it.
TIMEZONE=America/Chicago
# When check-in is open: days and HH:MM-HH:MM, several windows separated by ";".
# Days: MON TUE WED THU FRI SAT SUN, comma separated or as a range (MON-FRI).
# Empty means always open (a good setting while you try the app out).
# Example for a Monday/Wednesday/Friday 8-9 AM class:  CHECKIN_WINDOWS=MON,WED,FRI 08:00-09:00
CHECKIN_WINDOWS=
# How long a check-in code stays valid (regular sessions), and for test sessions.
CHECKIN_CODE_TTL_SECONDS=300
TEST_CODE_TTL_HOURS=24
# Attendance percentage thresholds mapped to points, highest first: "<percent>:<points>,..."
GRADE_SCALE=85:10,75:8,50:5,0:0

# --- Infrastructure ----------------------------------------------------------
# Any SQLAlchemy URL. SQLite is fine for one class.
DATABASE_URL=sqlite:///./attendance.db
# Comma-separated origins allowed to call the API from another site. Empty (default)
# means same-origin only, which is what the bundled pages need.
CORS_ORIGINS=
HOST=0.0.0.0
PORT=8000

# --- Optional tuning (defaults shown) ----------------------------------------
# ACCESS_TOKEN_EXPIRE_HOURS=8
# Rate limiting (see the README): free wrong attempts per (account, IP), the longest delay in
# seconds, and the per-IP cap on failed attempts at accounts that do not exist.
# RATE_LIMIT_FREE_FAILURES=2
# RATE_LIMIT_BACKOFF_MAX_SECONDS=300
# RATE_LIMIT_UNKNOWN_PER_IP=60
# RATE_LIMIT_WINDOW_SECONDS=60
# Reverse proxies whose X-Forwarded-For header is believed (IPs or CIDRs, comma-separated).
# Leave empty unless you know your proxy's address; see DEPLOYMENT_GUIDE.md.
# TRUSTED_PROXIES=

# --- Used by start.sh only (containers and PaaS) ------------------------------
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
